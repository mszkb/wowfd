# Optional: andere TSM-CSV je Region. Standard:
# https://public-data.tradeskillmaster.com/retail/{region}/commodities.csv
TSM_CSV_URL_EU=
TSM_CSV_URL_US=

# Optional: kommagetrennte Item-IDs, die gespeichert werden (leer = alle)
TSM_ITEM_IDS=

# Vercel Blob – per `vercel env pull` holen
BLOB_READ_WRITE_TOKEN=
# Muss zum Typ des Blob-Stores passen: private (Standard) oder public
BLOB_ACCESS=private

# Schützt /api/cron; Vercel sendet ihn als "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
